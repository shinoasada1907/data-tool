{
  "paths" : {
    "/api/import-sessions" : {
      "post" : {
        "description" : "Checks the type (extension and content) and size (20MB by default), reads the whole file once and creates an import session in CONFIGURING, with an empty target schema. Errors: 415 FILE_UNSUPPORTED, 413 FILE_TOO_LARGE, 422 FILE_EMPTY or FILE_PARSE_ERROR.",
        "operationId" : "upload",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "properties" : {
                  "file" : {
                    "format" : "binary",
                    "type" : "string"
                  }
                },
                "required" : [ "file" ],
                "type" : "object"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportSessionDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Upload a CSV or XLSX file",
        "tags" : [ "Import sessions" ]
      }
    },
    "/api/import-sessions/{id}" : {
      "get" : {
        "description" : "Status, file metadata, configuration and readiness of the session. Errors: 404 SESSION_NOT_FOUND.",
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportSessionDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Read an import session",
        "tags" : [ "Import sessions" ]
      }
    },
    "/api/import-sessions/{id}/errors/export" : {
      "get" : {
        "description" : "CSV, UTF-8 with BOM: rowNumber,fieldName,stage,rule,step,code,message,sourceValue, one line per error. Errors: 404 SESSION_NOT_FOUND, 409 RESULT_NOT_AVAILABLE, 500 EXPORT_FAILED.",
        "operationId" : "errorReport",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Download the error report",
        "tags" : [ "Export" ]
      }
    },
    "/api/import-sessions/{id}/export" : {
      "get" : {
        "description" : "format=json: an array of objects, keys in schema order, typed values. format=csv: UTF-8 with BOM, RFC 4180, header in schema order, text cells guarded against formulas. Only valid rows. Errors: 400 REQUEST_INVALID (format missing or not json/csv), 404 SESSION_NOT_FOUND, 409 RESULT_NOT_AVAILABLE (as GET /result), 500 EXPORT_FAILED. An error after the file has started drops the connection, so the download fails instead of ending short.",
        "operationId" : "export",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "format",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Download the valid rows",
        "tags" : [ "Export" ]
      }
    },
    "/api/import-sessions/{id}/mapping" : {
      "put" : {
        "description" : "Lists only mapped fields; each takes its value from a source column (exact name from the preview) or a constant. Replaces the whole mapping; mappings come back in schema order. Every unmapped field is reported in warnings as TARGET_FIELD_UNMAPPED; the session is READY only when every required field is mapped. Errors: 400 REQUEST_INVALID (malformed body), 404 SESSION_NOT_FOUND, 409 SESSION_STATE_INVALID, 422 MAPPING_INVALID or SOURCE_COLUMN_NOT_FOUND (every problem listed in errors, field = the target field).",
        "operationId" : "updateMapping",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MappingConfigDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConfigUpdateResponseDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Replace the field mapping",
        "tags" : [ "Configuration" ]
      }
    },
    "/api/import-sessions/{id}/preview" : {
      "get" : {
        "description" : "Columns in file order, total data rows, and the first rows with their spreadsheet row numbers (header is row 1). Errors: 400 REQUEST_INVALID (limit outside 1-200), 404 SESSION_NOT_FOUND, 409 SESSION_STATE_INVALID (file not read yet).",
        "operationId" : "preview",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "How many data rows to return (1-200)",
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 50,
            "format" : "int32",
            "maximum" : 200,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SourcePreviewDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Preview the source file",
        "tags" : [ "Import sessions" ]
      }
    },
    "/api/import-sessions/{id}/process" : {
      "post" : {
        "description" : "Maps, transforms and validates every row of the file, stores the result and moves the session to PROCESSED. Synchronous; calling it again re-runs and replaces the result. Errors: 404 SESSION_NOT_FOUND, 409 SESSION_NOT_READY (readiness issues in errors), 409 SESSION_STATE_INVALID (session failed), 422 FILE_PARSE_ERROR (file broken since upload; fails the session for good), 500 INTERNAL_ERROR. A 500 fails the session only when the file itself cannot be read; when the result cannot be stored the session and its previous result are unchanged, so read the session again to tell.",
        "operationId" : "process",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PipelineSummaryDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Run the import",
        "tags" : [ "Processing" ]
      }
    },
    "/api/import-sessions/{id}/result" : {
      "get" : {
        "description" : "Valid or invalid rows by increasing row number, with the summary of the whole result. view: valid (default) or invalid; page from 0; size 1-200 (default 50). field and code keep the invalid rows having one error that matches both; they are ignored for valid rows. Errors: 400 REQUEST_INVALID, 404 SESSION_NOT_FOUND, 409 RESULT_NOT_AVAILABLE (not processed, or the configuration changed since).",
        "operationId" : "result",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "view",
          "required" : false,
          "schema" : {
            "default" : "valid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 50,
            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "field",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "code",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PipelineResultDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Read the result a page at a time",
        "tags" : [ "Processing" ]
      }
    },
    "/api/import-sessions/{id}/schema" : {
      "put" : {
        "description" : "Replaces the whole schema. Names are trimmed; fields come back sorted by order and renumbered from 0. Configuration of fields that no longer exist is removed and reported in warnings. The session moves to READY when nothing else is missing, otherwise to CONFIGURING. Errors: 400 REQUEST_INVALID (malformed body), 404 SESSION_NOT_FOUND, 409 SESSION_STATE_INVALID (file not read yet, or session failed), 422 SCHEMA_INVALID (every problem listed in errors, field = the trimmed name or null).",
        "operationId" : "updateSchema",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TargetSchemaDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConfigUpdateResponseDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Replace the target schema",
        "tags" : [ "Configuration" ]
      }
    },
    "/api/import-sessions/{id}/transformations" : {
      "put" : {
        "description" : "A flat list of steps {targetField, order, type, params?}; each field's steps run by order. Types: trim, uppercase, lowercase (no params), defaultValue {value}, dateFormat {inputFormat, outputFormat? = yyyy-MM-dd}; a date field must output yyyy-MM-dd. Replaces the whole list; an empty list removes every step. Steps come back in schema order, then by order. Errors: 400 REQUEST_INVALID (malformed body), 404 SESSION_NOT_FOUND, 409 SESSION_STATE_INVALID, 422 CONFIG_INVALID (every problem listed in errors).",
        "operationId" : "updateTransformations",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TransformationConfigDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConfigUpdateResponseDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Replace the transformations",
        "tags" : [ "Configuration" ]
      }
    },
    "/api/import-sessions/{id}/validations" : {
      "put" : {
        "description" : "Rules {targetField, type, params?}: email (string fields only) and unique. required and type come from the schema: sending them, or email on an email field, is not an error but comes back as a RULE_IMPLIED_BY_SCHEMA warning and is not stored. Replaces the whole list; rules come back in schema order, email before unique. Errors: 400 REQUEST_INVALID (malformed body), 404 SESSION_NOT_FOUND, 409 SESSION_STATE_INVALID, 422 CONFIG_INVALID (every problem listed in errors).",
        "operationId" : "updateValidations",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ValidationConfigDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConfigUpdateResponseDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Replace the validation rules",
        "tags" : [ "Configuration" ]
      }
    }
  },
  "schemas" : {
    "ColumnDto" : {
      "properties" : {
        "index" : {
          "format" : "int32",
          "type" : "integer"
        },
        "name" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "ConfigUpdateResponseDto" : {
      "properties" : {
        "session" : {
          "$ref" : "#/components/schemas/ImportSessionDto"
        },
        "warnings" : {
          "items" : {
            "$ref" : "#/components/schemas/ProblemItem"
          },
          "type" : "array"
        }
      },
      "type" : "object"
    },
    "FieldMappingDto" : {
      "properties" : {
        "constantValue" : {
          "description" : "Non-blank value for every row; only for CONSTANT",
          "type" : "string"
        },
        "mappingType" : {
          "description" : "SOURCE_COLUMN or CONSTANT",
          "example" : "SOURCE_COLUMN",
          "type" : "string"
        },
        "sourceColumn" : {
          "description" : "Exact name of a source column; only for SOURCE_COLUMN",
          "example" : "Họ tên",
          "type" : "string"
        },
        "targetField" : {
          "description" : "Name of a field in the target schema (exact match)",
          "example" : "name",
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "ImportErrorDto" : {
      "properties" : {
        "code" : {
          "type" : "string"
        },
        "fieldName" : {
          "type" : "string"
        },
        "message" : {
          "type" : "string"
        },
        "rowNumber" : {
          "format" : "int32",
          "type" : "integer"
        },
        "rule" : {
          "type" : "string"
        },
        "sourceValue" : {
          "type" : "string"
        },
        "stage" : {
          "type" : "string"
        },
        "step" : {
          "format" : "int32",
          "type" : "integer"
        }
      },
      "type" : "object"
    },
    "ImportSessionDto" : {
      "properties" : {
        "config" : {
          "$ref" : "#/components/schemas/SessionConfigDto"
        },
        "createdAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "fileType" : {
          "enum" : [ "CSV", "XLSX" ],
          "type" : "string"
        },
        "id" : {
          "format" : "uuid",
          "type" : "string"
        },
        "originalFileName" : {
          "type" : "string"
        },
        "readiness" : {
          "$ref" : "#/components/schemas/ReadinessDto"
        },
        "sizeBytes" : {
          "format" : "int64",
          "type" : "integer"
        },
        "status" : {
          "enum" : [ "UPLOADED", "CONFIGURING", "READY", "PROCESSED", "FAILED" ],
          "type" : "string"
        },
        "updatedAt" : {
          "format" : "date-time",
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "Item" : {
      "properties" : {
        "params" : {
          "additionalProperties" : {
            "type" : "string"
          },
          "description" : "No rule takes parameters in V0.1",
          "type" : "object"
        },
        "targetField" : {
          "description" : "Name of a field in the target schema",
          "example" : "email",
          "type" : "string"
        },
        "type" : {
          "description" : "email (string fields only) or unique; required and type come from the schema",
          "example" : "unique",
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "MappingConfigDto" : {
      "properties" : {
        "mappings" : {
          "items" : {
            "$ref" : "#/components/schemas/FieldMappingDto"
          },
          "type" : "array"
        }
      },
      "required" : [ "mappings" ],
      "type" : "object"
    },
    "PageDto" : {
      "properties" : {
        "number" : {
          "format" : "int32",
          "type" : "integer"
        },
        "size" : {
          "format" : "int32",
          "type" : "integer"
        },
        "totalElements" : {
          "format" : "int64",
          "type" : "integer"
        },
        "totalPages" : {
          "format" : "int32",
          "type" : "integer"
        }
      },
      "type" : "object"
    },
    "PipelineResultDto" : {
      "properties" : {
        "page" : {
          "$ref" : "#/components/schemas/PageDto"
        },
        "rows" : {
          "items" : {
            "$ref" : "#/components/schemas/ResultRowDto"
          },
          "type" : "array"
        },
        "summary" : {
          "$ref" : "#/components/schemas/PipelineSummaryDto"
        },
        "view" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "PipelineSummaryDto" : {
      "properties" : {
        "errorCountsByCode" : {
          "additionalProperties" : {
            "format" : "int64",
            "type" : "integer"
          },
          "type" : "object"
        },
        "errorCountsByField" : {
          "additionalProperties" : {
            "format" : "int64",
            "type" : "integer"
          },
          "type" : "object"
        },
        "invalid" : {
          "format" : "int64",
          "type" : "integer"
        },
        "processedAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "sessionId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "status" : {
          "enum" : [ "UPLOADED", "CONFIGURING", "READY", "PROCESSED", "FAILED" ],
          "type" : "string"
        },
        "total" : {
          "format" : "int64",
          "type" : "integer"
        },
        "valid" : {
          "format" : "int64",
          "type" : "integer"
        }
      },
      "type" : "object"
    },
    "ProblemItem" : {
      "properties" : {
        "code" : {
          "type" : "string"
        },
        "field" : {
          "type" : "string"
        },
        "message" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "ReadinessDto" : {
      "properties" : {
        "issues" : {
          "items" : {
            "$ref" : "#/components/schemas/ProblemItem"
          },
          "type" : "array"
        },
        "ready" : {
          "type" : "boolean"
        }
      },
      "type" : "object"
    },
    "ResultRowDto" : {
      "properties" : {
        "errors" : {
          "items" : {
            "$ref" : "#/components/schemas/ImportErrorDto"
          },
          "type" : "array"
        },
        "rowNumber" : {
          "format" : "int32",
          "type" : "integer"
        },
        "valid" : {
          "type" : "boolean"
        },
        "values" : {
          "additionalProperties" : { },
          "type" : "object"
        }
      },
      "type" : "object"
    },
    "RowDto" : {
      "properties" : {
        "rowNumber" : {
          "format" : "int64",
          "type" : "integer"
        },
        "values" : {
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        }
      },
      "type" : "object"
    },
    "SessionConfigDto" : {
      "properties" : {
        "mapping" : {
          "$ref" : "#/components/schemas/MappingConfigDto"
        },
        "schema" : {
          "$ref" : "#/components/schemas/TargetSchemaDto"
        },
        "transformations" : {
          "$ref" : "#/components/schemas/TransformationConfigDto"
        },
        "validations" : {
          "$ref" : "#/components/schemas/ValidationConfigDto"
        }
      },
      "type" : "object"
    },
    "SourcePreviewDto" : {
      "properties" : {
        "columns" : {
          "items" : {
            "$ref" : "#/components/schemas/ColumnDto"
          },
          "type" : "array"
        },
        "fileType" : {
          "enum" : [ "CSV", "XLSX" ],
          "type" : "string"
        },
        "previewLimit" : {
          "format" : "int32",
          "type" : "integer"
        },
        "rows" : {
          "items" : {
            "$ref" : "#/components/schemas/RowDto"
          },
          "type" : "array"
        },
        "sessionId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "sheetName" : {
          "type" : "string"
        },
        "totalRows" : {
          "format" : "int64",
          "type" : "integer"
        }
      },
      "type" : "object"
    },
    "TargetFieldDto" : {
      "properties" : {
        "name" : {
          "description" : "Trimmed; 1-100 characters; unique case-insensitively",
          "example" : "email",
          "type" : "string"
        },
        "order" : {
          "description" : "Display position; values must be distinct and are renumbered 0..n-1",
          "example" : 0,
          "format" : "int32",
          "type" : "integer"
        },
        "required" : {
          "description" : "Defaults to false",
          "type" : "boolean"
        },
        "type" : {
          "description" : "One of string, number, boolean, date, email",
          "example" : "email",
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "TargetSchemaDto" : {
      "properties" : {
        "fields" : {
          "items" : {
            "$ref" : "#/components/schemas/TargetFieldDto"
          },
          "type" : "array"
        }
      },
      "required" : [ "fields" ],
      "type" : "object"
    },
    "TransformationConfigDto" : {
      "properties" : {
        "transformations" : {
          "items" : {
            "$ref" : "#/components/schemas/Item"
          },
          "type" : "array"
        }
      },
      "required" : [ "transformations" ],
      "type" : "object"
    },
    "ValidationConfigDto" : {
      "properties" : {
        "validations" : {
          "items" : {
            "$ref" : "#/components/schemas/Item"
          },
          "type" : "array"
        }
      },
      "required" : [ "validations" ],
      "type" : "object"
    }
  }
}