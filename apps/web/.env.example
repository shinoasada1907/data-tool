# Chép thành .env (đã gitignore) nếu cần đổi giá trị mặc định.

# Đích proxy /api khi chạy `pnpm dev`. Chỉ dùng trong vite.config.ts, không lộ ra trình duyệt.
API_PROXY_TARGET=http://localhost:8080

# Giới hạn upload (MB) kiểm trước khi gửi. Phải khớp IMPORTER_MAX_FILE_SIZE của BE.
VITE_MAX_UPLOAD_MB=20

# "true" thì bật MSW worker trên trình duyệt để chạy FE không cần BE. `pnpm dev:mock` đã bật sẵn qua .env.mock.
VITE_USE_MOCK=false
